<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#121110" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Alya Bazen Duygularını Rusça Saklar</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="progress"><span id="progressBar"></span></div>

  <header class="bar">
    <a class="brand" href="#" id="homeBtn">
      <span class="brand-title">Alya Bazen Duygularını Rusça Saklar</span>
      <span class="brand-sub" id="brandSub">Cilt 4 · Türkçe</span>
    </a>

    <nav class="tools">
      <div class="seg seg-vol" role="group" aria-label="Cilt seçimi">
        <button id="vol4" class="seg-btn is-on" type="button" title="Cilt 4">4</button>
        <button id="vol45" class="seg-btn" type="button" title="Cilt 4.5">4.5</button>
      </div>
      <button class="toc-btn" id="tocBtn" type="button" aria-haspopup="true" aria-expanded="false">
        <span id="tocLabel">Bölüm</span>
        <span class="caret">▾</span>
      </button>
      <div class="seg" role="group" aria-label="Görünüm">
        <button id="modeText" class="seg-btn is-on" type="button">Çeviri</button>
        <button id="modePage" class="seg-btn" type="button">Orijinal</button>
      </div>
      <button class="icon" id="fontDown" type="button" title="Yazıyı küçült">A−</button>
      <button class="icon" id="fontUp" type="button" title="Yazıyı büyüt">A+</button>
      <button class="icon mode-compact" id="modeBtn" type="button">Çeviri</button>
      <button class="icon" id="themeBtn" type="button" title="Tema (t)">☾</button>
    </nav>
  </header>

  <div class="toc-panel" id="tocPanel" hidden>
    <p class="toc-head">İçindekiler</p>
    <ul class="toc-list" id="tocList"></ul>
  </div>

  <main id="main">
    <article id="reader" class="reader" aria-live="polite"></article>
  </main>

  <footer class="nav">
    <button class="nav-btn" id="prevBtn" type="button" title="Önceki (←)">←</button>
    <div class="nav-mid">
      <input id="pageRange" type="range" min="1" max="282" value="1" aria-label="Sayfa" />
      <div class="count"><span id="pageNow">1</span> / <span id="pageTotal">282</span></div>
    </div>
    <button class="nav-btn" id="nextBtn" type="button" title="Sonraki (→)">→</button>
  </footer>

  <script src="/app.js"></script>
</body>
</html>
