(() => {
  const $ = (id) => document.getElementById(id);
  const reader = $('reader');

  const LS = {
    get(k, d) {
      try {
        const v = localStorage.getItem('alya4:' + k);
        return v === null ? d : JSON.parse(v);
      } catch {
        return d;
      }
    },
    set(k, v) {
      try {
        localStorage.setItem('alya4:' + k, JSON.stringify(v));
      } catch {}
    },
  };

  const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
  const state = {
    page: LS.get('page', 1),
    mode: LS.get('mode', 'text'),
    theme: LS.get('theme', prefersLight ? 'light' : 'dark'),
    size: LS.get('size', 1.06),
    book: null,
    zoom: false,
    vol: LS.get('vol', '4'),
  };

  /* ---------------- cilt ---------------- */
  function switchVolume(v) {
    if (v === state.vol) return;
    LS.set('page:' + state.vol, state.page);
    state.vol = v;
    LS.set('vol', v);
    state.page = LS.get('page:' + v, 1);
    load().catch(() => {});
  }
  $('vol4').addEventListener('click', () => switchVolume('4'));
  $('vol45').addEventListener('click', () => switchVolume('4.5'));

  /* ---------------- tema ---------------- */
  function applyTheme() {
    document.documentElement.dataset.theme = state.theme;
    $('themeBtn').textContent = state.theme === 'dark' ? '☾' : '☀';
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', state.theme === 'dark' ? '#121110' : '#fbf9f5');
  }

  function applySize() {
    document.documentElement.style.setProperty('--reader-size', state.size.toFixed(2) + 'rem');
  }

  /* ---------------- veri ---------------- */
  async function load() {
    const res = await fetch('/api/book?v=' + encodeURIComponent(state.vol));
    state.book = await res.json();
    const saved = LS.get('page:' + state.vol, 1);
    if (state.page < 1 || state.page > state.book.total) state.page = saved;
    $('brandSub').textContent = state.book.volume + ' · Türkçe';
    $('vol4').classList.toggle('is-on', state.vol === '4');
    $('vol45').classList.toggle('is-on', state.vol === '4.5');
    document.title = 'Alya Bazen Duygularını Rusça Saklar · ' + state.book.volume;
    const { total, chapters } = state.book;
    $('pageRange').max = total;
    $('pageTotal').textContent = total;

    const list = $('tocList');
    list.innerHTML = '';
    for (const ch of chapters) {
      const li = document.createElement('li');
      li.dataset.page = ch.page;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = '';
      const lab = document.createElement('span');
      lab.className = 'ch-label';
      lab.textContent = ch.label;
      const ttl = document.createElement('span');
      ttl.className = 'ch-title';
      ttl.textContent = ch.title;
      const pg = document.createElement('span');
      pg.className = 'ch-page';
      pg.textContent = ch.page;
      btn.append(lab, ttl, pg);
      btn.addEventListener('click', () => {
        goto(ch.page);
        toggleToc(false);
      });
      li.appendChild(btn);
      list.appendChild(li);
    }
    if (!(state.page >= 1 && state.page <= total)) state.page = 1;
    render();
  }

  const currentPage = () => state.book.pages[state.page - 1];
  const chapterAt = (n) => {
    let found = state.book.chapters[0];
    for (const ch of state.book.chapters) if (ch.page <= n) found = ch;
    return found;
  };
  const isChapterStart = (n) => state.book.chapters.some((c) => c.page === n && c.page !== 1);

  /* ---------------- çizim ---------------- */
  function render() {
    if (!state.book) return;
    const p = currentPage();
    const ch = chapterAt(state.page);
    const start = isChapterStart(state.page);

    reader.innerHTML = '';

    if (state.mode === 'page') {
      renderImage(p);
    } else {
      const hasText = p.tr.length > 0;

      if (start) {
        const k = document.createElement('p');
        k.className = 'kicker';
        k.textContent = ch.label;
        reader.appendChild(k);

        const h = document.createElement('h1');
        h.className = 'chapter-title';
        h.textContent = ch.title;
        reader.appendChild(h);
      }

      if (!hasText) {
        const note = document.createElement('p');
        note.className = 'empty-note';
        note.textContent =
          state.book.pages[state.page - 1].en.length > 0
            ? 'Bu sayfanın metni güvenilir şekilde okunamadı — orijinal görsel gösteriliyor.'
            : 'Bu sayfada metin yok — görsel sayfa.';
        reader.appendChild(note);
        renderImage(p, true);
      } else {
        let paras = p.tr.slice();
        // bölüm başlığı ilk paragrafın içinde tekrar etmesin
        if (start && paras[0]) {
          const t = paras[0];
          const q = t.indexOf('"');
          const looksHeading = /^(?:\d+\.\s*)?(Bölüm|Önsöz|Sonsöz|Epilog|Prolog)\b/.test(t);
          if (looksHeading && q > 0 && q < 140) {
            paras[0] = t.slice(q);
          } else if (looksHeading) {
            const i = t.indexOf(ch.title);
            if (i >= 0) {
              const rest = t.slice(i + ch.title.length).replace(/^[:\s"”]+/, '');
              if (rest.length > 40) paras[0] = rest;
              else paras.shift();
            }
          }
        }
        for (const t of paras) {
          const el = document.createElement('p');
          if (t.startsWith('"')) el.className = 'dialog';
          el.textContent = t;
          reader.appendChild(el);
        }
        if (p.en.length === 0) {
          const note = document.createElement('p');
          note.className = 'empty-note';
          note.textContent = 'Bu sayfanın metni çıkarılamadı; orijinal görünümü deneyin.';
          reader.appendChild(note);
        }
      }
    }

    const foot = document.createElement('p');
    foot.className = 'page-foot';
    foot.textContent = 'Sayfa ' + state.page;
    reader.appendChild(foot);

    // durum
    $('pageNow').textContent = state.page;
    $('pageRange').value = state.page;
    $('prevBtn').disabled = state.page <= 1;
    $('nextBtn').disabled = state.page >= state.book.total;
    $('progressBar').style.width = ((state.page / state.book.total) * 100).toFixed(2) + '%';
    $('tocLabel').textContent = ch.label;
    for (const li of $('tocList').children) {
      li.classList.toggle('is-current', Number(li.dataset.page) === ch.page);
    }
    $('modeText').classList.toggle('is-on', state.mode === 'text');
    $('modePage').classList.toggle('is-on', state.mode === 'page');
    $('modeBtn').textContent = state.mode === 'text' ? 'Çeviri' : 'Orijinal';

    LS.set('page', state.page);
    LS.set('mode', state.mode);
    LS.set('theme', state.theme);
    LS.set('size', state.size);

    window.scrollTo({ top: 0 });
    prefetch();
  }

  function renderImage(p, inline = false) {
    const fig = document.createElement('figure');
    fig.className = 'page-img' + (inline ? ' inline' : '') + (state.zoom && !inline ? ' zoom' : '');
    const img = document.createElement('img');
    img.src = p.img;
    img.alt = 'Sayfa ' + p.n;
    img.loading = 'eager';
    img.decoding = 'async';
    fig.appendChild(img);
    reader.appendChild(fig);

    if (!inline) {
      fig.addEventListener('click', () => {
        fig.classList.toggle('zoom');
        state.zoom = fig.classList.contains('zoom');
      });
      const hint = document.createElement('p');
      hint.className = 'img-hint';
      hint.textContent = 'Yakınlaştırmak için görsele dokun';
      reader.appendChild(hint);
    }
  }

  function prefetch() {
    for (const d of [1, -1, 2]) {
      const n = state.page + d;
      const p = state.book.pages[n - 1];
      if (p) {
        const i = new Image();
        i.src = p.img;
      }
    }
  }

  /* ---------------- gezinme ---------------- */
  function goto(n) {
    if (!state.book) return;
    state.page = Math.min(Math.max(1, n), state.book.total);
    render();
  }
  const next = () => goto(state.page + 1);
  const prev = () => goto(state.page - 1);

  /* ---------------- olaylar ---------------- */
  $('prevBtn').addEventListener('click', prev);
  $('nextBtn').addEventListener('click', next);
  $('modeBtn').addEventListener('click', () => {
    state.mode = state.mode === 'text' ? 'page' : 'text';
    state.zoom = false;
    render();
  });
  $('pageRange').addEventListener('input', (e) => goto(Number(e.target.value)));
  function toggleToc(open) {
    const panel = $('tocPanel');
    const next = open === undefined ? panel.hidden : open;
    panel.hidden = !next;
    $('tocBtn').setAttribute('aria-expanded', String(next));
  }

  $('tocBtn').addEventListener('click', (e) => {
    e.stopPropagation();
    toggleToc();
  });

  document.addEventListener('click', (e) => {
    if (!$('tocPanel').hidden && !$('tocPanel').contains(e.target)) toggleToc(false);
  });

  $('modeText').addEventListener('click', () => {
    state.mode = 'text';
    state.zoom = false;
    render();
  });
  $('modePage').addEventListener('click', () => {
    state.mode = 'page';
    render();
  });
  $('themeBtn').addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    applyTheme();
    LS.set('theme', state.theme);
  });
  $('fontUp').addEventListener('click', () => {
    state.size = Math.min(1.45, +(state.size + 0.06).toFixed(2));
    applySize();
    LS.set('size', state.size);
  });
  $('fontDown').addEventListener('click', () => {
    state.size = Math.max(0.9, +(state.size - 0.06).toFixed(2));
    applySize();
    LS.set('size', state.size);
  });
  $('homeBtn').addEventListener('click', (e) => {
    e.preventDefault();
    goto(state.book.chapters[1] ? state.book.chapters[1].page : 1);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return toggleToc(false);
    if (e.target.matches('input, select, textarea')) return;
    if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'j') next();
    else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'k') prev();
    else if (e.key === 't') $('themeBtn').click();
    else if (e.key === 'v') (state.mode === 'text' ? $('modePage') : $('modeText')).click();
    else return;
    e.preventDefault();
  });

  let tx = 0;
  let ty = 0;
  document.addEventListener(
    'touchstart',
    (e) => {
      tx = e.touches[0].clientX;
      ty = e.touches[0].clientY;
    },
    { passive: true }
  );
  document.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - tx;
      const dy = e.changedTouches[0].clientY - ty;
      if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.6) {
        dx < 0 ? next() : prev();
      }
    },
    { passive: true }
  );

  applyTheme();
  applySize();
  load().catch((err) => {
    reader.innerHTML = '<p class="empty-note">Kitap verisi yüklenemedi: ' + err.message + '</p>';
  });
})();
