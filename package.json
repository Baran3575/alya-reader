{
  "name": "alya-reader",
  "version": "2.0.0",
  "description": "Alya Bazen Duygularını Rusça Saklar — Cilt 4 – 12 (4.5 ve 9.5 dahil) Türkçe web okuyucu",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ingest": "node scripts/ingest/cli.js",
    "translate": "node scripts/translate_llm.js",
    "build:bundle": "node scripts/build_bundle.js",
    "build:site": "node scripts/build_site.js",
    "test": "node test/qc-verification.test.js && node test/ingest-and-pipeline.test.js && node test/fidelity.test.js && node scripts/qc/argo.js --check && node scripts/qc/caps.js --check && node scripts/qc/cli.js --strict --check-regression",
    "test:suite": "node test/qc-verification.test.js && node test/ingest-and-pipeline.test.js",
    "qc": "node scripts/qc/cli.js",
    "qc:strict": "node scripts/qc/cli.js --strict",
    "qc:v4": "node scripts/qc/cli.js --volume 4 --strict --check-regression",
    "qc:v45": "node scripts/qc/cli.js --volume 4.5 --strict --check-regression",
    "patch:dry": "node scripts/patch.js --dry-run",
    "patch:apply": "node scripts/patch.js",
    "fix:delim": "node scripts/fix_delim_junk.js",
    "fix:delim:dry": "node scripts/fix_delim_junk.js --dry",
    "en:qc": "node scripts/qc/en_quality.js",
    "en:fix": "node scripts/fix_en_ocr.js",
    "en:ads": "node scripts/qc/en_ads.js",
    "pretest": "node scripts/fix_quality.js && node scripts/insert_notes.js && node scripts/build_bundle.js",
    "fix:quality": "node scripts/fix_quality.js",
    "fix:quality:dry": "node scripts/fix_quality.js --dry",
    "fidelity": "node scripts/qc/fidelity.js",
    "deep": "node scripts/qc/deep.js",
    "fix:style": "node scripts/fix_style.js",
    "fix:style:dry": "node scripts/fix_style.js --dry",
    "clean": "node scripts/qc/clean.js --md",
    "fix:dialog": "node scripts/fix_split_dialog.js",
    "fix:quotes": "node scripts/fix_nested_quotes.js",
    "caps": "node scripts/qc/caps.js --md",
    "chapter": "node scripts/qc/chapter.js",
    "next": "node scripts/qc/chapter.js --next"
  },
  "keywords": [
    "alya",
    "roshidere",
    "light-novel",
    "reader",
    "turkish-translation",
    "qc"
  ],
  "author": "Baran3575",
  "license": "MIT"
}
